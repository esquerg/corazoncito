# Servidor
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Base de datos (SQLite)
DATABASE_URL=./data/corazoncito.sqlite

# CORS — origen del frontend (Vite)
CORS_ORIGIN=http://localhost:5173

# JWT — usa secretos largos y aleatorios en producción
JWT_ACCESS_SECRET=dev_access_secret_cambia_esto_en_produccion
JWT_REFRESH_SECRET=dev_refresh_secret_cambia_esto_en_produccion
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Usuario dueño inicial (seed)
SEED_OWNER_NAME=Owner
SEED_OWNER_EMAIL=owner@corazoncito.cafe
SEED_OWNER_PASSWORD=corazoncito123
